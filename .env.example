# Copy to .env and fill in. .env is git-ignored. Never commit real passwords.
# Every lab address, user, password and #tag lives here only (no defaults in code).
# A live run stops before the first test if one of them is blank.

# ---- NCP under test ----
NCP_HOST=10.4.5.10
NCP_USER=superadmin
NCP_PASSWORD=
# Default is wss://<NCP_HOST>/api/v1/ws. Older builds used wss://<host>:9001/api/v1/ws
NCP_WS_URI=
# Optional. Project chat is not wired yet (field name not confirmed) - leave blank for admin chat.
NCP_PROJECT_ID=

# ---- Connector tags used in the chat (#tag routes the prompt to that connector) ----
# Confirmed on 10.4.5.10 (2026-10-07). Copy them exactly as the NCP UI shows them.
TAG_NEXUS=#nexus-mcp
TAG_CATALYST=#catalyst-mcp
TAG_ZABBIX=#zabbix
TAG_ONES=#ones-37-mcp
TAG_PROMETHEUS=#prometheus-mcp
TAG_DCGM=#dcgm
TAG_BCM=#bcm
TAG_DYNAMO=#dynamo-mcp

# ---- Ground-truth sources (read directly, read-only) ----
NEXUS_URL=https://10.20.11.3
NEXUS_USER=
NEXUS_PASSWORD=
NEXUS_DOMAIN=DefaultAuth

CATALYST_URL=https://10.4.5.230
CATALYST_USER=
CATALYST_PASSWORD=

ZABBIX_URL=http://10.4.4.177:8088
ZABBIX_USER=
ZABBIX_PASSWORD=

ONES_URL=https://10.20.0.37
ONES_USER=
ONES_PASSWORD=
# Optional: an ONES endpoint that lists links (LLDP neighbours). Blank = link check BLOCKED.
ONES_LINKS_PATH=

# GPU metrics (2026-10-08): both connectors read the Prometheus the DCGM exporters feed.
# Prometheus user / password are optional (basic auth, as in the NCP connector); DCGM has no login.
PROMETHEUS_URL=http://10.20.0.41:9091
PROMETHEUS_USER=
PROMETHEUS_PASSWORD=
DCGM_URL=http://10.20.0.41:9091

# BCM (2026-10-14): REST API with a client certificate — one PEM file with the certificate and the key (git-ignored).
# Path relative to this folder, or absolute. No user / password.
BCM_URL=https://10.20.13.243:8081
BCM_CERT=bcm-client-combined.pem
# Dynamo (2026-10-14): the connector's vLLM /metrics URLs, comma separated. 10.4.5.33:8000 is also NCP's own LLM.
DYNAMO_URL=http://10.4.5.33:8000/metrics,https://10.20.11.73:8120/metrics

# ---- Device used for the <DEVICE> prompts (blank = picked automatically) ----
DEVICE_NEXUS=
DEVICE_CATALYST=
DEVICE_ZABBIX=
DEVICE_ONES=
# B02 asks for this BCM node: "show me the network interfaces for bcm-head" (Dev, 2026-10-14)
DEVICE_BCM=bcm-head
# <MODEL> in the Dynamo prompts (blank = the model the vLLM endpoints serve)
DEVICE_DYNAMO=

# ---- Compare tolerances (absolute) ----
CPU_TOL=10
MEM_TOL=3
TEMP_TOL=3
# GPU utilization (points) · GPU power draw (% of the source value)
GPU_UTIL_TOL=10
POWER_TOL=10
# GPU framebuffer MiB (% of the source value)
FB_TOL=10

# ---- Grading (blank = the default shown) ----
# 1 (default): a list answer that shows only part of the data PASSES ("partial: ...") when all of it
# matches the source; wrong or invented data still FAILs. 0: every source item must be shown.
PARTIAL_PASS=
# Metric prompts: sample the source every this many seconds while NCP answers. Default 20
METRIC_POLL_SECONDS=

# ---- Optional LLM judge: adds a second-opinion note, never changes a result ----
JUDGE_URL=
JUDGE_MODEL=gpt-oss-120b

# ---- Optional LLM reader: when the code reading of an answer FAILs, an LLM copies NCP's answer into a
# table and the same code grades it (it never decides PASS / FAIL). OpenAI-compatible base URL; blank = off.
# Dev's choice on 2026-10-07: http://10.4.5.33:8000/v1 (vLLM gpt-oss-120b) — note: that is also NCP's own LLM
# and Dynamo endpoint #1, so reader calls add load there and show in its metrics.
EXTRACT_URL=
EXTRACT_MODEL=gpt-oss-120b
# Repeat a FAIL once in a new chat (FAIL then PASS = PASS "flaky: ..."). Default 1; 0 = off
REPEAT_FAILS=

# ---- Optional chat tuning (blank = the default shown) ----
# After NCP's end frame (agent_complete), wait this long for late content, then stop. Default 3
WS_END_GRACE_SECONDS=
# Only used if NCP sends no end frame: this much silence after text ends the answer. Default 45
WS_QUIET_SECONDS=
# Attempts per prompt on connection errors (connect / auth / closed). Default 3
CHAT_RETRIES=
# Repeats when NCP was asked but gave no answer in time / an empty answer. Default 1
ANSWER_RETRIES=
# Follow-up questions answered per prompt. Default 3
MAX_FOLLOWUPS=
